!notebooks/experiments/*/config.yaml
!notebooks/experiments/*/notebook.ipynb
!notebooks/experiments/*/notebook.html
!notebooks/experiments/*/summary.json
!notebooks/experiments/*/metrics.csv
!notebooks/experiments/*/figures/

